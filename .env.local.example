# Copy this file to .env.local and fill in your own Clerk Publishable Key.
# Get one at https://dashboard.clerk.com — create an application, then enable
# "Organizations" under Organization Settings (required for the multi-tenant
# org selector and onboarding flow).
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase project (real backend/persistence). Create a free project at
# https://supabase.com, then:
#   1. Visit https://dashboard.clerk.com/setup/supabase, activate the
#      integration, and copy the revealed Clerk domain.
#   2. In Supabase: Authentication -> Sign In / Providers -> Add provider ->
#      Clerk -> paste that domain.
#   3. Run supabase/schema.sql (in this repo) in the Supabase SQL Editor.
#   4. Copy your Project URL and anon public key below.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
